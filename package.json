    "@hono/clerk-auth": "^2.0.0",
    "@hono/node-server": "^1.8.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/forms": "^0.5.6",
    "@tiptap/extension-placeholder": "^2.4.0",
