# Copy to .env for local development. Never commit populated environment files.
# VITE_* values are public and are embedded in the browser bundle.

# Server runtime
API_SERVER_PORT=3003
CRON_SERVER_PORT=3004
FRONTEND_URL=http://localhost:5173

# GitHub App (server)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_NAME=
GITHUB_CALLBACK_URL=
GITHUB_APP_WEBHOOK_SECRET=

# Stripe (server)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_USAGE_METER_ID=

# Clerk (server)
CLERK_SECRET_KEY=

# Secrets encryption (server)
WALLIE_ENCRYPTION_KEY=


# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client (Vite) variables — must start with VITE_
VITE_API_SERVER_URL=http://localhost:3003
VITE_ENV=dev
VITE_CLERK_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICING_TABLE_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy S3/Spaces uploads (client): leave credentials blank.
# Do not put real storage credentials in VITE_* variables. See SECURITY.md.
# Uploads require a server-side implementation before deployment.
VITE_DO_SPACE_NAME=
VITE_DO_REGION=
VITE_DO_ACCESS_KEY_ID=
VITE_DO_SECRET_ACCESS_KEY=

# Product config (client)
VITE_FREE_TIER_AGENT_RUN_LIMIT=25
