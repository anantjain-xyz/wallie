# Environment
VITE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:54321/wallie

# Frontend
FRONTEND_URL=http://localhost:5173

# API Keys
VITE_CLERK_PUBLISHABLE_KEY=your_api_key_here
CLERK_SECRET_KEY=your_secret_key_here

# Ports
WRITE_SERVER_PORT=3001
PROXY_SERVER_PORT=3002
API_SERVER_PORT=3003

# GitHub App Configuration
GITHUB_APP_NAME="wallie-labs"
GITHUB_APP_ID="your_github_app_id_here"
GITHUB_APP_CLIENT_ID="your_github_app_client_id_here"
GITHUB_APP_CLIENT_SECRET="your_github_app_client_secret_here"
GITHUB_APP_PRIVATE_KEY="your_github_app_private_key_here"
GITHUB_APP_WEBHOOK_SECRET="your_github_app_webhook_secret_here"

# Anthropic API (for agent)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# DigitalOcean Spaces Configuration
VITE_DO_REGION="nyc3"
VITE_DO_SPACE_NAME="your_space_name_here"
VITE_DO_ACCESS_KEY_ID="your_digitalocean_access_key_id_here"
VITE_DO_SECRET_ACCESS_KEY="your_digitalocean_secret_access_key_here"