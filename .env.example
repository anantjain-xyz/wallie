# Environment
VITE_ENV=development

# Workspace tier settings
FREE_TIER_AGENT_RUN_LIMIT=25
VITE_FREE_TIER_AGENT_RUN_LIMIT=25

# Database
DATABASE_URL=postgresql://postgres:password@localhost:54321/wallie

# Secrets encryption (must be set for secrets API to work)
WALLIE_ENCRYPTION_KEY=replace_with_a_long_random_string

# Frontend
FRONTEND_URL=http://localhost:5173

# API Keys
VITE_CLERK_PUBLISHABLE_KEY=your_api_key_here
CLERK_SECRET_KEY=your_secret_key_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
VITE_STRIPE_PRICING_TABLE_ID=your_stripe_pricing_table_id_here

# Ports (don't need to be set for Render)
WRITE_SERVER_PORT=3001
PROXY_SERVER_PORT=3002
API_SERVER_PORT=3003

# URLs (need to be set for Render)
VITE_WRITE_SERVER_URL=http://localhost:$WRITE_SERVER_PORT
VITE_PROXY_SERVER_URL=http://localhost:$PROXY_SERVER_PORT
VITE_API_SERVER_URL=http://localhost:$API_SERVER_PORT
GITHUB_CALLBACK_URL=https://mac.tailscale.ID.ts.net/callback
ELECTRIC_SECRET="self-generated-secret-goes-here"

# GitHub App Configuration
GITHUB_APP_NAME="wallie-labs"
GITHUB_APP_ID="your_github_app_id_here"
GITHUB_APP_CLIENT_SECRET="your_github_app_client_secret_here"
GITHUB_APP_PRIVATE_KEY="your_github_app_private_key_here"
GITHUB_APP_WEBHOOK_SECRET="your_github_app_webhook_secret_here"

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT="your_langchain_project_name_here"
RELACE_API_KEY="your_relace_api_key_here"
RELACE_API_URL="https://instantapply.endpoint.relace.run/v1/code/apply"

# DigitalOcean Spaces Configuration
VITE_DO_REGION="nyc3"
VITE_DO_SPACE_NAME="your_space_name_here"
VITE_DO_ACCESS_KEY_ID="your_digitalocean_access_key_id_here"
VITE_DO_SECRET_ACCESS_KEY="your_digitalocean_secret_access_key_here"